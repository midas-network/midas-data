    <!-- http://purl.obolibrary.org/obo/NCIT_C38209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C38209">
        <obo:IAO_0000115>Administration of a substance by the way of the gastrointestinal tract, usually for systemic action. Drug bioavailability can be affected due to enzymatic degradation by intestinal tissues and microbes, and first-pass hepatic metabolism.</obo:IAO_0000115>
        <rdfs:label>Enteral Route of Administration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C51306 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C51306">
        <obo:IAO_0000115>The activities of educating or instructing or teaching; activities that impart knowledge or skill.</obo:IAO_0000115>
        <rdfs:label>Educational Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C71104 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C71104">
        <obo:IAO_0000115>A research study that prospectively assigns human participants or groups of humans to one or more health-related interventions to evaluate the effects on health outcomes.</obo:IAO_0000115>
        <rdfs:label>Clinical Trial</rdfs:label>
    </owl:Class>
</rdf:RDF>



